# Start the user-level ADB reverse helper when the configured Android phone is plugged in.
# USB debugging must already be enabled and this PC must already be authorized on the phone.
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="@ANDROID_VENDOR_ID@", MODE="0666", GROUP="plugdev", TAG+="uaccess", RUN+="/usr/sbin/runuser -u @TARGET_USER@ -- env XDG_RUNTIME_DIR=/run/user/@TARGET_UID@ /usr/bin/systemctl --user start phone-location-adb-reverse.service"
