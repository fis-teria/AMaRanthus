[Unit]
Description=Phone Location Bridge ADB reverse
After=default.target
StartLimitIntervalSec=30
StartLimitBurst=4

[Service]
Type=oneshot
Environment=PHONE_LOCATION_BRIDGE_PORT=@PHONE_LOCATION_BRIDGE_PORT@
Environment=PHONE_LOCATION_ADB_WAIT_TIMEOUT_SEC=@PHONE_LOCATION_ADB_WAIT_TIMEOUT_SEC@
ExecStart=@PHONE_LOCATION_ADB_AUTOREVERSE_SCRIPT@
KillMode=process
TimeoutStartSec=infinity

[Install]
WantedBy=default.target
